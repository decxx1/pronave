---
import HeroPage from '@/components/HeroPage.astro';
import Solutions from '@/components/services/Solutions.astro';
import type { Locale } from '@/i18n/config';
import { getTranslations } from '@/i18n/translations';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { SEOProps } from '@/types/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { services } = getTranslations(locale);
const seo = {
  ...services.seo,
  image: '/images/servicios/hero.webp',
} satisfies SEOProps;
---

<BaseLayout seo={seo} locale={locale} page="services">
  <HeroPage image="/images/servicios/hero.webp" content={services.hero} locale={locale} />
  <Solutions content={services.solutions} />
</BaseLayout>

