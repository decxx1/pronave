---
import '@/styles/global.css';
import 'aos/dist/aos.css';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/home/partials/Header.astro';
import { getLocalizedPath, getOpenGraphLocale, locales } from '@/i18n/config';
import type { Locale, PageKey } from '@/i18n/config';
import { getTranslations } from '@/i18n/translations';
import type { SEOProps } from '@/types/seo';

interface Props {
  seo: SEOProps;
  locale: Locale;
  page: PageKey;
}

const { seo, locale, page } = Astro.props;
const { common } = getTranslations(locale);
const site = Astro.site ?? new URL('https://pronave.com.ar');
const canonical = new URL(getLocalizedPath(locale, page), site).href;
const fullImg = new URL(seo.image, site).href;
const alternateLocales = locales.map((alternateLocale) => ({
  locale: alternateLocale,
  href: new URL(getLocalizedPath(alternateLocale, page), site).href,
}));
const openGraphLocale = getOpenGraphLocale(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      (() => {
        const preferenceKey = 'pronave-locale';
        const isHomePath = window.location.pathname === '/' || window.location.pathname === '';

        if (!isHomePath) return;

        let savedLocale = null;
        try {
          savedLocale = window.localStorage.getItem(preferenceKey);
        } catch {
          // Ignore storage restrictions and continue with browser detection.
        }

        if (savedLocale === 'es') return;
        if (savedLocale === 'en') {
          window.location.replace('/en/');
          return;
        }

        const languages = Array.isArray(navigator.languages) && navigator.languages.length
          ? navigator.languages
          : [navigator.language];
        const preferredLocale = languages
          .map((language) => language.toLowerCase())
          .map((language) => (language.startsWith('en') ? 'en' : language.startsWith('es') ? 'es' : null))
          .find(Boolean);

        if (preferredLocale === 'en') {
          window.location.replace('/en/');
        }
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Favicons -->
    <link href="/images/logos/favicon/favicon.svg" type="image/svg+xml" rel="icon" />
    <link href="/images/logos/favicon/faviconx56.png" type="image/png" sizes="56x56" rel="icon" />
    <link href="/images/logos/favicon/faviconx32.png" type="image/png" sizes="32x32" rel="icon" />
    <link href="/images/logos/favicon/faviconx16.png" type="image/png" sizes="16x16" rel="icon" />
    <link href="/images/logos/favicon/faviconx180.png" rel="apple-touch-icon" sizes="180x180" />

    <title>{seo.title}</title>

    <!-- SEO -->
    <link rel="canonical" href={canonical} />
    {alternateLocales.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath('es', page), site).href} />
    <meta name="description" content={seo.metaDescription} />
    <meta http-equiv="Cache-Control" content="no-cache" />
    <meta http-equiv="Expires" content="Mon, 01 Jul 1970 00:00:00 GMT" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Facebook Open Graph -->
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullImg} />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta property="og:site_name" content="Pronave" />
    <meta property="og:locale" content={openGraphLocale} />
    {alternateLocales
      .filter((alternate) => alternate.locale !== locale)
      .map((alternate) => (
        <meta property="og:locale:alternate" content={getOpenGraphLocale(alternate.locale)} />
      ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    {seo.twitterSite && <meta name="twitter:site" content={seo.twitterSite} />}
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.metaDescription} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={fullImg} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
  </head>
  <body>
    <Header content={common.header} locale={locale} page={page} />
    <slot />
    <Footer content={common.footer} locale={locale} />
    <FloatingWhatsApp content={common.whatsapp} />

    <script>
      import AOS from 'aos';

      let isAOSInitialized = false;

      const initializeAOS = () => {
        if (isAOSInitialized) {
          requestAnimationFrame(() => AOS.refreshHard());
          return;
        }

        AOS.init({
          duration: 700,
          easing: 'ease-out-cubic',
          offset: 80,
          once: true,
          mirror: false,
          disable: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
        });

        isAOSInitialized = true;
        requestAnimationFrame(() => AOS.refresh());
      };

      initializeAOS();
      document.addEventListener('astro:page-load', initializeAOS);
    </script>
  </body>
</html>
<style is:global>
	/*recaptcha*/
	.grecaptcha-badge {
		width: 70px !important;
		height: 60px !important;
		overflow: hidden !important;
		transition: all 0.3s ease !important;
		left: 4px !important;
		z-index: 100;
	}

	.grecaptcha-badge:hover {
		width: 256px !important;
	}
</style>
