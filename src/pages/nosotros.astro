---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPage from '../components/HeroPage.astro';
import ValueProposition from '../components/nosotros/ValueProposition.astro';
import Mission from '../components/nosotros/Mission.astro';
import Vision from '../components/nosotros/Vision.astro';
import Values from '../components/nosotros/Values.astro';
import type { SEOProps } from '../types/seo';

const seo = {
  title: 'Pronave | Expertos en logística internacional',
  metaDescription:
    'Conocé a Pronave, el aliado técnico para operaciones de comercio exterior que aporta experiencia, trazabilidad, adaptación y acompañamiento profesional.',
  canonical: '/nosotros/',
  image: '/images/home/nosotros.webp',
  imageAlt: 'Equipo de Pronave en su oficina',
} satisfies SEOProps;
---

<BaseLayout seo={seo}>
  <HeroPage
    image="/images/home/nosotros.webp"
    imageAlt="Equipo de Pronave en su oficina"
  />
  <ValueProposition />
  <Mission />
  <Vision />
  <Values />
</BaseLayout>
