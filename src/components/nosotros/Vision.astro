---
const paragraph =
  'Consolidarnos como un aliado de servicios logísticos internacionales que brinda respuestas y soluciones profesionales cada vez que la operación lo exige, asegurando el desarrollo eficiente de sus proyectos. Nuestro fin es generar relaciones de largo plazo con nuestros clientes.';
---

<section id="vision" class="relative overflow-hidden bg-white py-14 text-ink sm:py-20 lg:py-24">
  <img
    src="/images/shapes/shape-arrow.svg"
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="pointer-events-none absolute -right-24 sm:-right-40 md:-right-24 lg:-right-36 xl:-right-40 -bottom-10 sm:bottom-0 z-0 h-64 w-auto max-w-[110%] scale-x-[-1] object-contain object-right opacity-0 lg:opacity-100 sm:h-64 lg:h-96 lg:max-w-[58vw] xl:h-112 2xl:max-w-xl rotate-y-180"
  />

  <div class="relative z-10 grid grid-cols-1 items-stretch gap-8 lg:grid-cols-2 lg:gap-0 xl:mx-auto xl:w-full xl:max-w-310 xl:gap-16 xl:px-16 2xl:px-0">
    <div
      class="h-64 overflow-hidden sm:h-72 md:h-96 lg:h-144 lg:min-h-80 xl:min-h-full"
      data-aos="fade-right"
      data-aos-duration="800"
    >
      <img
        src="/images/nosotros/vision.webp"
        alt="Profesional de Pronave con casco y chaleco de seguridad frente a contenedores"
        loading="lazy"
        class="h-full w-full object-cover object-center"
      />
    </div>

    <div
      class="relative px-6 sm:px-10 lg:flex lg:min-h-80 lg:flex-col lg:pl-8 lg:pr-12 xl:min-h-full xl:px-0"
      data-aos="fade-left"
      data-aos-delay="100"
    >
      <div class="relative z-10 text-right">
        <div class="ml-auto inline-block text-left">
          <h3 class="font-body text-3xl font-semibold leading-none tracking-tight sm:text-4xl lg:text-5xl">
            Visión
          </h3>
          <span aria-hidden="true" class="mt-4 block h-1.5 w-full bg-brand-blue sm:mt-5"></span>
        </div>

        <p class="mt-8 font-body text-base leading-relaxed tracking-tight sm:mt-10 sm:text-lg lg:text-xl">
          {paragraph}
        </p>
      </div>
    </div>
  </div>
</section>
