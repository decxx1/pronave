---
import {
  CONTACT_ADDRESS,
  CONTACT_EMAIL,
  CONTACT_HOURS,
  CONTACT_PHONE,
  CONTACT_WEBSITE,
  SOCIAL_INSTAGRAM_URL,
  SOCIAL_LINKEDIN_URL,
  SOCIAL_WHATSAPP_URL,
} from 'astro:env/client';

const contactItems = [
  {
    icon: 'phone-icon.svg',
    alt: 'Teléfono',
    content: CONTACT_PHONE,
    href: CONTACT_PHONE ? `tel:${CONTACT_PHONE.replace(/\D/g, '')}` : undefined,
  },
  {
    icon: 'email-icon.svg',
    alt: 'Correo electrónico',
    content: CONTACT_EMAIL,
    href: CONTACT_EMAIL ? `mailto:${CONTACT_EMAIL}` : undefined,
  },
  {
    icon: 'web-icon.svg',
    alt: 'Sitio web',
    content: CONTACT_WEBSITE,
    href: CONTACT_WEBSITE ? `https://${CONTACT_WEBSITE.replace(/^https?:\/\//, '')}` : undefined,
  },
  {
    icon: 'clock-icon.svg',
    alt: 'Horarios de atención',
    content: CONTACT_HOURS,
  },
  {
    icon: 'map-icon.svg',
    alt: 'Dirección',
    content: CONTACT_ADDRESS,
  },
].filter((item) => item.content);

const socialItems = [
  { icon: 'linkedin-icon.svg', alt: 'LinkedIn', href: SOCIAL_LINKEDIN_URL },
  { icon: 'instagram-icon.svg', alt: 'Instagram', href: SOCIAL_INSTAGRAM_URL },
  { icon: 'whatsapp-icon.svg', alt: 'WhatsApp', href: SOCIAL_WHATSAPP_URL },
].filter((item) => item.href);
---

<footer class="bg-white text-ink">
  <div class="relative h-24 overflow-hidden bg-contact-blue">
    <img
      src="/images/shapes/symbol-shape-transparent.svg"
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="pointer-events-none absolute right-0 top-1/2 h-40 w-auto -translate-y-1/2 sm:right-[10%]"
    />
  </div>

  <div class="mx-auto flex w-full max-w-310 flex-col gap-12 px-6 py-12 sm:px-10 sm:py-14 lg:flex-row lg:items-end lg:justify-between lg:px-12 lg:py-16 xl:px-16 2xl:px-0">
    <div class="w-full lg:max-w-240">
      <h2 class="font-display text-3xl font-semibold leading-none sm:text-4xl">Oficina central</h2>

      <ul class="mt-8 space-y-5 font-body text-lg sm:text-xl">
        {contactItems.map((item) => (
          <li class="flex items-center gap-5">
            <img
              src={`/images/contact-icons/${item.icon}`}
              alt={item.alt}
              loading="lazy"
              class="size-6 lg:size-7 shrink-0 object-contain"
            />
            {item.href ? (
              <a href={item.href} class="transition-opacity hover:opacity-70">{item.content}</a>
            ) : (
              <span>{item.content}</span>
            )}
          </li>
        ))}
      </ul>

      <nav aria-label="Redes sociales" class="mt-10 flex items-center gap-5">
        {socialItems.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer" aria-label={item.alt} class="transition-opacity hover:opacity-70">
            <img
              src={`/images/contact-icons/${item.icon}`}
              alt={item.alt}
              loading="lazy"
              class="size-16"
            />
          </a>
        ))}
      </nav>
    </div>

    <img
      src="/images/logos/logo-simple-color.svg"
      alt="Pronave"
      loading="lazy"
      class="mx-auto h-auto w-64 lg:mx-0 lg:w-72"
    />
  </div>
</footer>
