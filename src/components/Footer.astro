---
import {
  CONTACT_ADDRESS,
  CONTACT_EMAIL,
  CONTACT_HOURS_EN,
  CONTACT_HOURS_ES,
  CONTACT_PHONE,
  SOCIAL_FACEBOOK_URL,
  SOCIAL_INSTAGRAM_URL,
  SOCIAL_LINKEDIN_URL,
  SOCIAL_WHATSAPP_URL,
} from 'astro:env/client';
import type { CommonTranslations } from '@/i18n/translations';
import type { Locale } from '@/i18n/config';

interface Props {
  content: CommonTranslations['footer'];
  locale: Locale;
}

const { content, locale } = Astro.props;
const officeHours = locale === 'en' ? CONTACT_HOURS_EN : CONTACT_HOURS_ES;

const contactItems = [
  {
    icon: 'phone-icon.svg',
    alt: content.contactAlts.phone,
    content: CONTACT_PHONE,
    href: CONTACT_PHONE ? `tel:${CONTACT_PHONE.replace(/\D/g, '')}` : undefined,
  },
  {
    icon: 'email-icon.svg',
    alt: content.contactAlts.email,
    content: CONTACT_EMAIL,
    href: CONTACT_EMAIL ? `mailto:${CONTACT_EMAIL}` : undefined,
  },
  {
    icon: 'clock-icon.svg',
    alt: content.contactAlts.hours,
    content: officeHours,
  },
  {
    icon: 'map-icon.svg',
    alt: content.contactAlts.address,
    content: CONTACT_ADDRESS,
  },
].filter((item) => item.content);

const socialItems = [
  { icon: 'linkedin-icon.svg', alt: 'LinkedIn', href: SOCIAL_LINKEDIN_URL },
  { icon: 'facebook-icon.svg', alt: 'Facebook', href: SOCIAL_FACEBOOK_URL },
  { icon: 'instagram-icon.svg', alt: 'Instagram', href: SOCIAL_INSTAGRAM_URL },
  { icon: 'whatsapp-icon.svg', alt: 'WhatsApp', href: SOCIAL_WHATSAPP_URL },
].filter((item) => item.href);
---

<footer class="bg-white text-ink">
  <div class="relative h-24 overflow-hidden bg-contact-blue">
    <img
      src="/images/shapes/symbol-shape-transparent.svg"
      alt={content.decorativeAlt}
      aria-hidden="true"
      loading="lazy"
      class="pointer-events-none absolute right-0 top-1/2 h-40 w-auto -translate-y-1/2 sm:right-[10%]"
    />
  </div>

  <div class="mx-auto flex w-full max-w-310 flex-col gap-12 px-6 py-12 sm:px-10 sm:py-14 lg:flex-row lg:items-end lg:justify-between lg:px-12 lg:py-16 xl:px-16 2xl:px-0">
    <div class="w-full lg:max-w-240">
      <h2 class="font-display text-3xl font-semibold leading-none sm:text-4xl">{content.officeTitle}</h2>

      <ul class="mt-8 space-y-5 font-body text-lg sm:text-xl">
        {contactItems.map((item) => (
          <li class="flex items-center gap-5">
            <img
              src={`/images/contact-icons/${item.icon}`}
              alt={item.alt}
              loading="lazy"
              class="size-6 lg:size-7 shrink-0 object-contain"
            />
            {item.href ? (
              <a href={item.href} class="transition-opacity hover:opacity-70">{item.content}</a>
            ) : (
              <span>{item.content}</span>
            )}
          </li>
        ))}
      </ul>

      <nav aria-label={content.socialNavigationLabel} class="mt-10 flex items-center gap-5">
        {socialItems.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer" aria-label={item.alt} class="transition-opacity hover:opacity-70">
            <img
              src={`/images/contact-icons/${item.icon}`}
              alt={item.alt}
              loading="lazy"
              class="size-16"
            />
          </a>
        ))}
      </nav>
    </div>

    <img
      src="/images/logos/logo-simple-color.svg"
      alt="Pronave"
      loading="lazy"
      class="mx-auto h-auto w-64 lg:mx-0 lg:w-72"
    />
  </div>

  <section class="mx-auto flex w-full max-w-310 flex-col items-center gap-6 px-6 pb-10 sm:px-10 lg:flex-row lg:items-center lg:justify-between lg:px-12 xl:px-16 2xl:px-0">
    <ul>
      <li class="mt-1 text-center lg:text-left">
        <span class="inline-flex">
          <span class="border-2 border-[#77bb5d] px-2 py-1 text-sm text-ink lg:text-base">
            {content.carbonAmount} <em class="whitespace-nowrap not-italic">{content.carbonPerView} </em>
          </span>
          <span class="-ml-2 border-2 border-[#77bb5d] bg-[#77bb5d] px-2 py-1 text-sm font-bold whitespace-nowrap text-white lg:text-base">
            Website Carbon
          </span>
        </span>
        <p class="mt-1 text-center text-xs font-light text-ink/70 lg:text-left lg:text-sm">{content.carbonComparison}</p>
      </li>
    </ul>

    <p class="text-center text-sm font-light text-ink/70 lg:text-base">
      {content.designedBy}{' '}
      <a
        href="https://tresvecestres.com.ar/"
        target="_blank"
        rel="noreferrer"
        class="font-normal text-ink underline-offset-2 transition-opacity hover:opacity-70 hover:underline"
      >
        tresvecestres
      </a>
    </p>
  </section>
</footer>
