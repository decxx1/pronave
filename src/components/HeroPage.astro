---
interface Props {
  image: string;
  imageAlt?: string;
}

const {
  image,
  imageAlt = 'Operación logística de Pronave',
} = Astro.props;
---

<section class="relative isolate flex min-h-svh items-start overflow-hidden bg-hero text-white">
  <img
    src={image}
    alt={imageAlt}
    loading="lazy"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
  />
  <div class="absolute inset-0 -z-10 bg-linear-to-b from-black/75 via-black/25 to-transparent"></div>

  <div class="relative z-10 mx-auto w-full max-w-310 px-6 pb-12 pt-40 sm:px-10 sm:pb-16 sm:pt-48 lg:px-12 lg:pb-20 lg:pt-52 xl:px-16 2xl:px-0">
    <div class="max-w-208">
      <h1 class="max-w-160 font-body text-5xl font-light italic leading-none tracking-tighter sm:text-6xl xl:text-7xl">
        Built on trust.<br />
        Driven by expertise.
      </h1>

      <a
        href="/#contacto"
        class="mt-12 inline-flex min-h-16 items-center border border-white bg-brand-blue/85 px-6 py-3 font-body text-xl font-light italic leading-none transition-colors hover:bg-brand-blue focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:mt-14 sm:min-w-64 sm:justify-center sm:text-2xl"
      >
        CONTACTANOS
      </a>
    </div>
  </div>
</section>
