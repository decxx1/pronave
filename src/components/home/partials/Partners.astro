---
import type { HomeTranslations } from '@/i18n/translations';

interface Props {
  content: HomeTranslations['partners'];
}

const { content } = Astro.props;
const partnerFiles = [
  'amc-logo-white.svg',
  'grupo-peñaflor-logo-white.svg',
  'hoyer-logo-white.svg',
  'logo-evergreen-white.svg',
  'logo-maersk-white.svg',
  'logo-one-white.svg',
  'medlog-logo-white.svg',
  'perfopro-logo-white.svg',
  'robinson-logo-white.svg',
  'solt-nielsen-logo-white.svg',
  'stm-logo-white.svg',
  'total-trade-group.svg',
];
const partners = content.items.map((name, index) => ({ name, file: partnerFiles[index] }));
---

<section id="partners" class="mt-8 bg-linear-to-r from-partners-start to-partners-end py-12 text-white sm:py-16 lg:py-20">
  <div class="mx-auto w-full max-w-310 px-6 sm:px-10 lg:px-12 xl:px-16 2xl:px-0">
    <h2
      class="mx-auto w-fit max-w-full bg-linear-to-r from-partners-title to-transparent px-6 py-4 text-center font-body text-xl font-normal md:leading-none md:tracking-tight sm:px-8 sm:py-5 sm:text-3xl lg:text-4xl"
      data-aos="fade-up"
    >
      {content.title}
    </h2>

    <div class="relative mt-10 sm:mt-14" data-aos="zoom-in">
      <button
        type="button"
        data-partners-prev
        aria-label={content.previousLabel}
        class="absolute left-0 top-1/2 z-10 -translate-x-full -translate-y-1/2 px-1 py-3 text-2xl leading-none text-white opacity-70 transition-opacity hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:pointer-events-none disabled:opacity-25 sm:text-3xl"
      >
        <span aria-hidden="true">◀</span>
      </button>

      <div class="overflow-hidden">
        <div data-partners-track class="-mx-2 flex w-auto transition-transform duration-500 ease-out">
          {partners.map((partner) => (
            <div class="w-full shrink-0 px-2 xs:w-1/2 md:w-1/3">
              <div class="flex h-32 items-center justify-center sm:h-36">
                <img
                  src={`/images/partners/${partner.file}`}
                  alt={partner.name}
                  loading="lazy"
                  class="h-20 w-56 object-contain"
                />
              </div>
            </div>
          ))}
        </div>
      </div>

      <button
        type="button"
        data-partners-next
        aria-label={content.nextLabel}
        class="absolute right-0 top-1/2 z-10 translate-x-full -translate-y-1/2 px-1 py-3 text-2xl leading-none text-white opacity-70 transition-opacity hover:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:pointer-events-none disabled:opacity-25 sm:text-3xl"
      >
        <span aria-hidden="true">▶</span>
      </button>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-partners-track]');
  const previous = document.querySelector<HTMLButtonElement>('[data-partners-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-partners-next]');
  const slides = track ? Array.from(track.children) : [];
  let currentIndex = 0;
  let visibleSlides = 1;
  let autoplayId: number | undefined;

  const getVisibleSlides = () => {
    if (window.matchMedia('(min-width: 48rem)').matches) return 3;
    if (window.matchMedia('(min-width: 30rem)').matches) return 2;
    return 1;
  };

  const updateCarousel = () => {
    if (!track) return;

    visibleSlides = getVisibleSlides();
    currentIndex = Math.min(currentIndex, Math.max(0, slides.length - visibleSlides));
    track.style.transform = `translateX(-${currentIndex * (100 / visibleSlides)}%)`;

    if (previous) previous.disabled = currentIndex === 0;
    if (next) next.disabled = currentIndex >= slides.length - visibleSlides;
  };

  const advanceCarousel = () => {
    const lastIndex = Math.max(0, slides.length - visibleSlides);
    currentIndex = currentIndex >= lastIndex ? 0 : currentIndex + 1;
    updateCarousel();
  };

  const restartAutoplay = () => {
    if (autoplayId !== undefined) window.clearInterval(autoplayId);
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      autoplayId = window.setInterval(advanceCarousel, 4000);
    }
  };

  previous?.addEventListener('click', () => {
    currentIndex = Math.max(0, currentIndex - 1);
    updateCarousel();
    restartAutoplay();
  });

  next?.addEventListener('click', () => {
    const lastIndex = Math.max(0, slides.length - visibleSlides);
    currentIndex = currentIndex >= lastIndex ? 0 : currentIndex + 1;
    updateCarousel();
    restartAutoplay();
  });

  window.addEventListener('resize', () => {
    updateCarousel();
    restartAutoplay();
  });

  updateCarousel();
  restartAutoplay();
</script>
