---
import ContactFormReact from './ContactFormReact.jsx';
---

<section id="contacto" aria-labelledby="contact-title" class="mb-20 relative isolate overflow-hidden bg-contact-blue text-white">
  <img
    src="/images/shapes/symbol-shape-transparent.svg"
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="pointer-events-none opacity-10 absolute -left-16 2xl:h-220 2xl:left-[5%] -top-24 -z-10 h-full w-auto max-w-none"
  />

  <div class="relative mx-auto grid w-full max-w-310 grid-cols-1 items-center gap-10 px-6 py-12 sm:px-10 sm:py-16 lg:grid-cols-2 lg:gap-16 lg:px-12 lg:py-20 xl:px-16 2xl:px-0">
    <div class="flex items-center justify-center lg:justify-start">
      <div class="w-full max-w-128 border border-white/60 px-6 py-6 sm:px-10 sm:py-8 lg:px-12 lg:py-10">
        <h2 id="contact-title" class="text-center font-display text-3xl font-light italic leading-none tracking-tight sm:text-left sm:text-5xl lg:text-6xl">
          Envíanos<br />tu consulta
        </h2>
      </div>
    </div>

    <ContactFormReact client:load />

    <img
      src="/images/logos/logo-simple-white.svg"
      alt="Pronave"
      loading="lazy"
      class="mx-auto h-auto w-52 sm:mx-0 sm:w-64 lg:col-start-1 lg:row-start-2 lg:ml-1"
    />
  </div>
</section>
